{{!
    @template core/login_panel

    Default content for the left panel of the split-screen login layout.

    When leftinstructions is provided (i.e. the site has custom auth instructions configured),
    it fully replaces the entire default welcome section (title, tagline, and stats).

    Example context (json):
    {
        "leftinstructions": "<p>Welcome to our learning platform. Please log in to continue.</p>"
    }
}}
<div class="login-layout-left-content" style="backdrop-filter: blur(8px); background-color: rgba(15, 23, 42, 0.75); border: 1px solid rgba(251, 191, 36, 0.35); border-radius: 18px; padding: 2.25rem; max-width: 480px; font-family: 'Noto Sans KR', sans-serif;">
    {{^leftinstructions}}
        <div style="display:inline-block; background:rgba(251, 191, 36, 0.18); border:1px solid rgba(251, 191, 36, 0.5); color:#fde68a; font-size:0.78rem; font-weight:800; letter-spacing:0.04em; padding:0.3rem 0.9rem; border-radius:999px; margin-bottom:1rem;">
            리드마스터 원서 도서관 · 온라인 학습관
        </div>
        <h1 class="h2 mb-3" style="font-weight:800; color:#ffffff; letter-spacing:-0.02em; word-break:keep-all;">
            리드마스터 영어독해·원서리딩 학원
        </h1>
        <div class="mx-auto mb-4 text-start" style="color:rgba(255,255,255,0.92); font-size:0.95rem; line-height:1.75; word-break:keep-all;">
            원서 다독·정독(옥스퍼드 리딩 트리, 매직트리하우스, 뉴베리 수상작)부터 중고등 내신 구문 분석, 수능 학술 비문학 추론, 시사 영자신문 에세이 첨삭까지 흔들리지 않는 진짜 영어 문해력을 완성합니다.
        </div>
        <div class="login-layout-stats" style="border-top:1px solid rgba(255,255,255,0.18); padding-top:1.25rem;">
            <div class="login-layout-stat">
                <strong class="login-layout-stat-value" style="color:#fbbf24;">수준별 원서</strong>
                <span style="font-size:0.8rem; color:rgba(255,255,255,0.85);">맞춤 도서 큐레이션</span>
            </div>
            <div class="login-layout-stat">
                <strong class="login-layout-stat-value" style="color:#fbbf24;">5단계 과정</strong>
                <span style="font-size:0.8rem; color:rgba(255,255,255,0.85);">체계적 독해 로드맵</span>
            </div>
            <div class="login-layout-stat">
                <strong class="login-layout-stat-value" style="color:#fbbf24;">1:1 밀착 코칭</strong>
                <span style="font-size:0.8rem; color:rgba(255,255,255,0.85);">원장·부원장 직강</span>
            </div>
        </div>
    {{/leftinstructions}}
    {{#leftinstructions}}
        <div class="mx-auto text-start">
            {{{leftinstructions}}}
        </div>
    {{/leftinstructions}}
</div>
