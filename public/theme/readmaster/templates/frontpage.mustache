{{!
    @template theme_readmaster/frontpage

    Page shell for the public home page shown to visitors.
    Moodle requires main_content in every layout; it renders below the brand sections
    and is usually empty because site home course lists are turned off for visitors.

    Example context (json):
    {
        "output": {
            "doctype": "<!DOCTYPE html>",
            "page_title": "Home",
            "favicon": "favicon.ico",
            "main_content": ""
        },
        "bodyattributes": "",
        "home": {"name": "Academy", "links": {}, "programs": [], "news": [], "contact": []}
    }
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="rm-home">
    {{{ output.standard_top_of_body_html }}}
    {{#home}}{{> theme_readmaster/frontpage_content }}{{/home}}
    <div id="page" class="rm-container">
        <div id="region-main" class="rm-main-content">
            {{{ output.main_content }}}
        </div>
    </div>
    {{#home}}{{> theme_readmaster/frontpage_footer }}{{/home}}
    {{{ output.standard_end_of_body_html }}}
</div>
</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
    M.util.js_complete('theme_boost/loader');
});
{{/js}}
