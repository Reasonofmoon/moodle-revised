{{!
    @template core/login_panel

    Left panel of the split login layout, branded from brand/profile.json.
    Admin-defined auth instructions still replace the default copy.

    Example context (json):
    {
        "brand": {"name": "리드마스터 입시학원", "tagline": "부천 옥길동, 초·중·고 영어 전문", "description": "", "logourl": "logo.png"}
    }
}}
<div class="login-layout-left-content rm-login-panel">
    {{#brand}}
        <span class="rm-login-logo"><img src="{{logourl}}" alt="" width="96" height="96"></span>
        <p class="rm-login-tagline">{{tagline}}</p>
        <h1 class="h2 rm-login-name">{{name}}</h1>
    {{/brand}}
    {{^leftinstructions}}
        {{#brand.description}}<p class="rm-login-desc">{{brand.description}}</p>{{/brand.description}}
        <p class="rm-login-cta">{{#str}}login_panel_cta, theme_readmaster{{/str}}</p>
    {{/leftinstructions}}
    {{#leftinstructions}}
        <div class="rm-login-desc text-start">{{{leftinstructions}}}</div>
    {{/leftinstructions}}
</div>
