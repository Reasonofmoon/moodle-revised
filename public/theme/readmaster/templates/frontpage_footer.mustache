{{!
    @template theme_readmaster/frontpage_footer

    Footer of the public home page.

    Example context (json):
    {
        "name": "리드마스터 입시학원",
        "tagline": "부천 옥길동, 초·중·고 영어 전문",
        "markurl": "logomark.png",
        "contact": [{"type": "address", "label": "주소", "value": "부천 옥길동"}],
        "hascontact": true,
        "year": "2026"
    }
}}
<footer class="rm-footer">
    <div class="rm-container rm-footer-inner">
        <div>
            <img src="{{markurl}}" alt="" class="rm-footer-logo" width="40" height="40">
            <p class="rm-footer-name">{{name}}</p>
            <p class="rm-footer-tagline">{{tagline}}</p>
        </div>
        {{#hascontact}}
        <dl class="rm-footer-contact">
            {{#contact}}
            <div><dt>{{label}}</dt><dd>{{value}}</dd></div>
            {{/contact}}
        </dl>
        {{/hascontact}}
        <p class="rm-footer-copy">© {{year}} {{name}}</p>
    </div>
</footer>
